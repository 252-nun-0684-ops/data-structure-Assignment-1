
import java.util.Scanner;

public class Task10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a = new int[5];
        int[] b = new int[5];
        int[] c = new int[10];

        // Takes input for the first array
        System.out.println("Enter 5 elements for array A:");
        for (int i = 0; i < 5; i++) {
            a[i] = sc.nextInt();
        }

        // Takes input for the second array
        System.out.println("Enter 5 elements for array B:");
        for (int i = 0; i < 5; i++) {
            b[i] = sc.nextInt();
        }

        // Copies the first array into the third array
        for (int i = 0; i < 5; i++) {
            c[i] = a[i];
        }

        // Adds the second array after the first array
        for (int i = 0; i < 5; i++) {
            c[i + 5] = b[i];
        }

        // Finds the largest element
        int max = c[0];
        for (int i = 1; i < 10; i++) {
            if (c[i] > max) {
                max = c[i];
            }
        }

        // Displays the merged array
        System.out.println("Merged array:");
        for (int i = 0; i < 10; i++) {
            System.out.print(c[i] + " ");
        }

        // Displays the largest element
        System.out.println("\nLargest element: " + max);

        sc.close();
    }
}
