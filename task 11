
import java.util.Scanner;

public class Task11 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a = new int[5];
        int[] b = new int[5];
        int[] c = new int[10];

        // Takes the first array in ascending order
        System.out.println("Enter 5 sorted elements for array A:");
        for (int i = 0; i < 5; i++) {
            a[i] = sc.nextInt();
        }

        // Takes the second array in ascending order
        System.out.println("Enter 5 sorted elements for array B:");
        for (int i = 0; i < 5; i++) {
            b[i] = sc.nextInt();
        }

        int i = 0, j = 0, k = 0;

        // Compares elements and inserts the smaller one
        while (i < 5 && j < 5) {
            if (a[i] <= b[j]) {
                c[k] = a[i];
                i++;
            } else {
                c[k] = b[j];
                j++;
            }
            k++;
        }

        // Copies any remaining elements from array A
        while (i < 5) {
            c[k] = a[i];
            i++;
            k++;
        }

        // Copies any remaining elements from array B
        while (j < 5) {
            c[k] = b[j];
            j++;
            k++;
        }

        // Displays the sorted merged array
        System.out.println("Merged sorted array:");
        for (int x = 0; x < 10; x++) {
            System.out.print(c[x] + " ");
        }

        sc.close();
    }
}
