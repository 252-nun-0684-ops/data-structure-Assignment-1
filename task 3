
import java.util.Scanner;

public class Task03 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        int sum = 0;

        // Takes input and calculates sum
        for (int i = 0; i < 10; i++) {
            System.out.print("Enter number: ");
            arr[i] = sc.nextInt();
            sum += arr[i];
        }

        // Calculates average using double for decimals
        double average = sum / 10.0;
        int count = 0;

        // Counts elements greater than average
        for (int i = 0; i < 10; i++) {
            if (arr[i] > average) {
                count++;
            }
        }

        // Displays results
        System.out.println("Sum: " + sum);
        System.out.println("Average: " + average);
        System.out.println("Elements greater than average: " + count);

        sc.close();
    }
}
