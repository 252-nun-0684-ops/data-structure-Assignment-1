
import java.util.Scanner;

public class Task05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];

        // Takes the original array input
        for (int i = 0; i < 10; i++) {
            System.out.print("Enter number: ");
            arr[i] = sc.nextInt();
        }

        // Gets the insertion index and new value
        System.out.print("Enter index (0 to 10): ");
        int index = sc.nextInt();
        System.out.print("Enter new number: ");
        int value = sc.nextInt();

        // Validates the index
        if (index < 0 || index > 10) {
            System.out.println("Invalid index.");
        } else {
            int[] newArr = new int[11];

            // Copies elements before the insertion index
            for (int i = 0; i < index; i++) {
                newArr[i] = arr[i];
            }

            // Inserts the new value
            newArr[index] = value;

            // Shifts remaining elements to the right
            for (int i = index; i < 10; i++) {
                newArr[i + 1] = arr[i];
            }

            // Displays the updated array
            System.out.println("Updated array:");
            for (int i = 0; i < 11; i++) {
                System.out.print(newArr[i] + " ");
            }
        }

        sc.close();
    }
}
