
import java.util.Scanner;

public class Task06 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];

        // Takes the original array input
        for (int i = 0; i < 10; i++) {
            System.out.print("Enter number: ");
            arr[i] = sc.nextInt();
        }

        // Gets the index to delete
        System.out.print("Enter index to delete (0 to 9): ");
        int index = sc.nextInt();

        // Validates the index
        if (index < 0 || index >= 10) {
            System.out.println("Invalid index.");
        } else {
            // Shifts elements after the deleted index left
            for (int i = index; i < 9; i++) {
                arr[i] = arr[i + 1];
            }

            // Displays only the remaining nine elements
            System.out.println("Updated array:");
            for (int i = 0; i < 9; i++) {
                System.out.print(arr[i] + " ");
            }
        }

        sc.close();
    }
}
