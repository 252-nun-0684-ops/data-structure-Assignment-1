
import java.util.Scanner;

public class Task09 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] arr = new int[10];
        boolean[] checked = new boolean[10];

        // Takes input
        for (int i = 0; i < 10; i++) {
            System.out.print("Enter number: ");
            arr[i] = sc.nextInt();
        }

        System.out.println("Duplicate elements:");

        // Checks each element
        for (int i = 0; i < 10; i++) {
            if (checked[i]) {
                continue; // Skips an already checked element
            }

            int count = 1;

            // Counts occurrences after the current index
            for (int j = i + 1; j < 10; j++) {
                if (arr[i] == arr[j]) {
                    count++;
                    checked[j] = true;
                }
            }

            // Displays only values occurring more than once
            if (count > 1) {
                System.out.println(arr[i] + " occurs " + count + " times");
            }
        }

        sc.close();
    }
}
